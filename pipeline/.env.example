# Supabase 프로젝트 설정 (프론트엔드 연동)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 백엔드 전용 (로컬 파이프라인에서만 쓰이므로 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-share

# Vercel 캐시 무효화 (On-Demand Revalidate)
VERCEL_REVALIDATE_URL=https://your-nextjs-app.vercel.app/api/revalidate
REVALIDATE_SECRET=your-revalidate-secret

# 공공데이터포털 API Key
OPEN_API_KEY=your-data-go-kr-api-key

# 내부 네트워크 통신용
CLICKHOUSE_URL=http://clickhouse:8123
